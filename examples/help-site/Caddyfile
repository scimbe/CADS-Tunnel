# Origin for the help.bunsenbrenner.org demo. Caddy terminates TLS, so it
# needs NO inbound :80/:443 of its own (the origin is only reachable through
# the tunnel). The agent (Browser Plane) forwards the raw TLS to this Caddy;
# TLS terminates here, at the origin, keeping the edge/plane payload-blind.
#
# #219: the cert is issued CORE-side (scripts/lib-acme.sh, deSEC DNS-01 with
# the operator's zone-wide token) and mounted in as static files — this
# Caddyfile only ever reads fullchain.pem/privkey.pem, never holds a DNS
# credential of its own.

help.bunsenbrenner.org {
	root * /srv
	file_server
	encode gzip
	tls /certs/fullchain.pem /certs/privkey.pem
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
	}
}
