# Origin for the cookbook.bunsenbrenner.org demo — same shape as flappy-demo/help-site: Caddy
# terminates TLS with a real Let's Encrypt cert via DNS-01 against deSEC, so it needs NO inbound
# :80/:443 of its own. The Browser-Plane agent forwards the raw TLS here; TLS terminates at this
# origin, keeping the edge/plane payload-blind.
{
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
	email admin@bunsenbrenner.org
}

cookbook.bunsenbrenner.org {
	# #201: the studio POSTs its {prompt, image?} here; the cookbook crew bridge runs
	# safety→structure→presentation→review over the tunnel and streams back the recipe. A more
	# specific matcher than the file_server below, so Caddy routes it first.
	reverse_proxy /cookbook/build cookbook-crew-bridge:8789
	root * /srv
	file_server
	encode gzip
	tls {
		dns desec {
			token {$DESEC_TOKEN}
		}
		resolvers ns1.desec.io ns2.desec.org
		dns_ttl 3600s
		propagation_delay 30s
		propagation_timeout 2m
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
	}
}
