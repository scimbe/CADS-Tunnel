# Self-host configuration + secrets template (M21.1b).
# Copy to docker/deploy/.env and edit. Do NOT commit the real .env.

# Published ports on the host.
CONTROL_PLANE_PORT=8090
EDGE_PORT=4433

# Proof-of-Work difficulty for rendezvous (higher = more abuse-resistant, more
# client cost). Production default is higher than the testbed's 8.
EDGE_POW_DIFFICULTY=16

# OIDC / Keycloak issuer URL (the realm). The control plane verifies bearer
# tokens on the /me/* endpoints against this issuer. Leave empty to disable
# authenticated endpoints during initial bring-up.
CT_OIDC_ISSUER=https://keycloak.example/realms/CADS-Tunnel

# --- Optional demo subsystems (examples/help-site, examples/flappy-demo) --------
# Only needed if you run the toggleable demo sites through the Browser Plane.

# deSEC API token so the demo's Caddy origin can obtain a Let's Encrypt cert via
# DNS-01 (help-site + flappy-demo). See docs/dns01-desec.md. Leave empty if unused.
DESEC_TOKEN=

# flappy-demo (#168): the first-layer gate password the operator sets out-of-band.
# examples/flappy-demo/run-demo.sh hashes THIS into an untracked gate.json (only the
# SHA-256 is ever stored/served — never the plaintext, never committed). Set it to
# your chosen demo password to bring flappy-demo.<zone> online; leave empty if unused.
FLAPPY_DEMO_PASSWORD=

# flappy-demo (#173) DISTRIBUTED crew bridge: the per-role channel-join identities the
# flappy-crew-bridge service dials source-2 (physics), sink (art) and the safety agent with,
# over the real Agent-Fabric tunnel. Provisioned by central alongside those agents' serving
# processes; all SECRET hex. The bridge is OPT-IN — it only starts with
# `docker compose --profile crew up`; the default `up` runs the demo without it (the page still
# works, /crew/build just 502s and the browser falls back to its local stand-in). Leave empty
# unless you run `--profile crew` with central's provisioned grants.
CREW_EDGE_BROKER=
CREW_EDGE_RELAY=
CREW_PHYSICS_GRANT=
CREW_PHYSICS_HOLDER_KEY=
CREW_PHYSICS_NOISE_KEY=
CREW_ART_GRANT=
CREW_ART_HOLDER_KEY=
CREW_ART_NOISE_KEY=
CREW_SAFETY_GRANT=
CREW_SAFETY_HOLDER_KEY=
CREW_SAFETY_NOISE_KEY=

# cookbook-demo (#201): the first-layer gate password (like FLAPPY_DEMO_PASSWORD). run-demo.sh hashes
# THIS into an untracked gate.json (SHA-256 only). Set to bring cookbook.<zone> online; empty if unused.
COOKBOOK_DEMO_PASSWORD=

# cookbook-demo (#201) DISTRIBUTED crew bridge: the per-role channel-join identities the
# cookbook-crew-bridge dials source-2 (structure), sink (presentation), and the safety+review agents
# with, over the real Agent-Fabric tunnel. Provisioned by central; all SECRET hex. The bridge is
# OPT-IN — only starts with `docker compose --profile crew up`. Leave empty unless running it.
COOKBOOK_EDGE_BROKER=
COOKBOOK_EDGE_RELAY=
COOKBOOK_SAFETY_GRANT=
COOKBOOK_SAFETY_HOLDER_KEY=
COOKBOOK_SAFETY_NOISE_KEY=
COOKBOOK_STRUCTURE_GRANT=
COOKBOOK_STRUCTURE_HOLDER_KEY=
COOKBOOK_STRUCTURE_NOISE_KEY=
COOKBOOK_PRESENTATION_GRANT=
COOKBOOK_PRESENTATION_HOLDER_KEY=
COOKBOOK_PRESENTATION_NOISE_KEY=
COOKBOOK_REVIEW_GRANT=
COOKBOOK_REVIEW_HOLDER_KEY=
COOKBOOK_REVIEW_NOISE_KEY=

# #214: the portal-session/gate-session HMAC signing key. Unset falls back to a
# fresh random key on every restart, which silently logs everyone out and drops
# every Browser-Plane login-gate session too. Generate with: openssl rand -hex 32
CT_PORTAL_SESSION_KEY=
