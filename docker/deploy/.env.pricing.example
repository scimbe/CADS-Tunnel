# Premium pricing/plan preview config template (admin-only preview page,
# /admin-ui/pricing-preview). Copy to docker/deploy/.env.pricing and fill in the
# REAL numbers there -- that file is git-ignored (see .gitignore's .env.* rule) and
# must never be committed. This example file exists only to document which
# CT_PRICING_* vars the app reads; every value below is an obviously-fake
# placeholder, not a real business number.
#
# All-unset is a valid, fully-supported state: the preview page renders a plain
# "pricing not configured on this deployment" message instead of erroring, so a
# fresh deploy (or CI) never needs this file to exist at all.

# Standard-tier AI usage rate, in hundredths-of-a-credit per 1,000 tokens
# (Chat/Completion, self-hosted model).
CT_PRICING_STANDARD_AI_CREDITS_PER_1K_TOKENS=999

# Standard-tier speech-to-text rate, in hundredths-of-a-credit per minute.
CT_PRICING_STANDARD_STT_CREDITS_PER_MINUTE=999

# Premium AI (external provider proxy) margin, as a percentage added on top of
# the real per-call provider cost.
CT_PRICING_PREMIUM_AI_MARGIN_PERCENT=99

# Relay-bandwidth overage rate, in hundredths-of-a-credit per GB, charged only
# above each plan's free relay quota.
CT_PRICING_RELAY_OVERAGE_CREDITS_PER_GB=999

# --- Plan tiers: price (euro-cents/month), included monthly credits, tunnel
# --- count, and relay-free-quota (GB/month). Five tiers: FREE, STARTER, MEDIUM,
# --- PRO, BUSINESS. FREE has no price/credits var (it's the zero-cost tier by
# --- definition) -- only its tunnel count and relay quota are configured.
CT_PRICING_FREE_TUNNELS=1
CT_PRICING_FREE_RELAY_GB=9

CT_PRICING_STARTER_PRICE_CENTS=999
CT_PRICING_STARTER_CREDITS=999
CT_PRICING_STARTER_TUNNELS=9
CT_PRICING_STARTER_RELAY_GB=99

CT_PRICING_MEDIUM_PRICE_CENTS=9999
CT_PRICING_MEDIUM_CREDITS=9999
CT_PRICING_MEDIUM_TUNNELS=9
CT_PRICING_MEDIUM_RELAY_GB=999

CT_PRICING_PRO_PRICE_CENTS=9999
CT_PRICING_PRO_CREDITS=9999
CT_PRICING_PRO_TUNNELS=99
CT_PRICING_PRO_RELAY_GB=9999

CT_PRICING_BUSINESS_PRICE_CENTS=99999
CT_PRICING_BUSINESS_NOTE="individual pricing, contact sales"
