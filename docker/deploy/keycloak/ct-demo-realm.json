{
  "realm": "ct-demo",
  "enabled": true,
  "sslRequired": "external",
  "smtpServer": {
    "host": "${KC_SMTP_HOST}",
    "port": "${KC_SMTP_PORT}",
    "from": "${KC_SMTP_FROM}",
    "fromDisplayName": "bunsenbrenner.org",
    "ssl": "${KC_SMTP_SSL}",
    "starttls": "${KC_SMTP_STARTTLS}",
    "auth": "true",
    "user": "${KC_SMTP_USER}",
    "password": "${KC_SMTP_PASSWORD}"
  },
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "failureFactor": 10,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "requiredActions": [
    {
      "alias": "TERMS_AND_CONDITIONS",
      "name": "Terms and Conditions",
      "providerId": "TERMS_AND_CONDITIONS",
      "enabled": true,
      "defaultAction": true,
      "priority": 10,
      "config": {}
    },
    {
      "alias": "delete_account",
      "name": "Delete Account",
      "providerId": "delete_account",
      "enabled": true,
      "defaultAction": false,
      "priority": 60,
      "config": {}
    },
    {
      "_comment": "Without this entry the realm-level verifyEmail flag above is INERT: Keycloak only enforces email confirmation when the VERIFY_EMAIL required-action provider is registered AND enabled. It was missing here, so accounts could be created and used with an unconfirmed address even after verifyEmail was switched on (found in production 2026-08-16 by registering an account and getting straight in).",
      "alias": "VERIFY_EMAIL",
      "name": "Verify Email",
      "providerId": "VERIFY_EMAIL",
      "enabled": true,
      "defaultAction": false,
      "priority": 50,
      "config": {}
    },
    {
      "_comment": "Registered so an admin-provisioned account's temporary password can force a change at first login (portal_api's ensure_user path). Was likewise unregistered.",
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": true,
      "defaultAction": false,
      "priority": 30,
      "config": {}
    }
  ],
  "defaultSignatureAlgorithm": "RS256",
  "clients": [
    {
      "clientId": "ct-portal",
      "name": "CADS-Tunnel customer portal",
      "secret": "${KC_PORTAL_CLIENT_SECRET}",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "${PORTAL_PUBLIC_URL}/portal/callback",
        "${PORTAL_PUBLIC_URL}/gate/callback",
        "http://localhost:8090/portal/callback",
        "http://localhost:8090/gate/callback"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "access.token.signed.response.alg": "RS256",
        "id.token.signed.response.alg": "RS256",
        "post.logout.redirect.uris": "${PORTAL_PUBLIC_URL}/portal##http://localhost:8090/portal"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "id",
            "claim.name": "sub",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ],
      "defaultClientScopes": [
        "email",
        "profile"
      ],
      "_comment_urls": "Keycloak's info pages (notably the one after clicking a verification link) only offer a way back into the app when the client has a base URL -- without these two fields the user was left on a bare 'your email has been verified' page with no link and no redirect. Kept as the same ${PORTAL_PUBLIC_URL} placeholder the redirect URIs use, so this stays portable across deployments.",
      "rootUrl": "${PORTAL_PUBLIC_URL}",
      "baseUrl": "/portal/tunnels"
    },
    {
      "clientId": "webconference-bridge",
      "name": "webconference-demo bridge (service account)",
      "description": "M2M credential for a downstream demo's bridge process (e.g. CADS-webconference-demo's bridge/server.js) -- calls /me/channels etc. via client_credentials instead of a browser-session cookie a control-plane restart can invalidate (core request, 2026-08-04). subject_of()/subject_of_channel() only ever check a valid bearer token's sub+iss (crates/control-plane/src/service.rs, crates/control-plane/src/oidc.rs) -- no extra realm role needed beyond this client existing and having a secret.",
      "secret": "${KC_WEBCONFERENCE_BRIDGE_CLIENT_SECRET:}",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "fullScopeAllowed": true
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "providerId": "google",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "linkOnly": false,
      "config": {
        "clientId": "${KC_GOOGLE_CLIENT_ID:}",
        "clientSecret": "${KC_GOOGLE_CLIENT_SECRET:}",
        "syncMode": "IMPORT"
      }
    },
    {
      "alias": "github",
      "providerId": "github",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "linkOnly": false,
      "config": {
        "clientId": "${KC_GITHUB_CLIENT_ID:}",
        "clientSecret": "${KC_GITHUB_CLIENT_SECRET:}",
        "syncMode": "IMPORT"
      }
    },
    {
      "alias": "gitlab",
      "providerId": "gitlab",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "linkOnly": false,
      "config": {
        "clientId": "${KC_GITLAB_CLIENT_ID:}",
        "clientSecret": "${KC_GITLAB_CLIENT_SECRET:}",
        "syncMode": "IMPORT"
      }
    }
  ],
  "loginTheme": "ct-bunsenbrenner",
  "accountTheme": "ct-bunsenbrenner",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "en",
    "de"
  ],
  "defaultLocale": "en"
}