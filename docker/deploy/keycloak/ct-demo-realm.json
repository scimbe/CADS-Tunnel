{
  "realm": "ct-demo",
  "enabled": true,
  "sslRequired": "external",
  "smtpServer": {
    "host": "${KC_SMTP_HOST}",
    "port": "${KC_SMTP_PORT}",
    "from": "${KC_SMTP_FROM}",
    "fromDisplayName": "bunsenbrenner.org",
    "ssl": "${KC_SMTP_SSL}",
    "starttls": "${KC_SMTP_STARTTLS}",
    "auth": "true",
    "user": "${KC_SMTP_USER}",
    "password": "${KC_SMTP_PASSWORD}"
  },
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "failureFactor": 10,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "requiredActions": [
    {
      "alias": "TERMS_AND_CONDITIONS",
      "name": "Terms and Conditions",
      "providerId": "TERMS_AND_CONDITIONS",
      "enabled": true,
      "defaultAction": true,
      "priority": 10,
      "config": {}
    },
    {
      "alias": "delete_account",
      "name": "Delete Account",
      "providerId": "delete_account",
      "enabled": true,
      "defaultAction": false,
      "priority": 60,
      "config": {}
    },
    {
      "alias": "VERIFY_EMAIL",
      "name": "Verify Email",
      "providerId": "VERIFY_EMAIL",
      "enabled": true,
      "defaultAction": false,
      "priority": 50,
      "config": {}
    },
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": true,
      "defaultAction": false,
      "priority": 30,
      "config": {}
    }
  ],
  "defaultSignatureAlgorithm": "RS256",
  "clients": [
    {
      "clientId": "ct-portal",
      "name": "CADS-Tunnel customer portal",
      "secret": "${KC_PORTAL_CLIENT_SECRET}",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "${PORTAL_PUBLIC_URL}/portal/callback",
        "${PORTAL_PUBLIC_URL}/gate/callback",
        "http://localhost:8090/portal/callback",
        "http://localhost:8090/gate/callback"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "access.token.signed.response.alg": "RS256",
        "id.token.signed.response.alg": "RS256",
        "post.logout.redirect.uris": "${PORTAL_PUBLIC_URL}/portal##http://localhost:8090/portal"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "id",
            "claim.name": "sub",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ],
      "defaultClientScopes": [
        "email",
        "profile"
      ],
      "rootUrl": "${PORTAL_PUBLIC_URL}",
      "baseUrl": "/portal/tunnels"
    },
    {
      "clientId": "webconference-bridge",
      "name": "webconference-demo bridge (service account)",
      "description": "M2M credential for a downstream demo's bridge process: calls /me/channels via client_credentials instead of a browser cookie a control-plane restart can invalidate. Details in docs/ops/ -- Keycloak caps this column at 255 chars.",
      "secret": "${KC_WEBCONFERENCE_BRIDGE_CLIENT_SECRET:}",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "fullScopeAllowed": true
    },
    {
      "clientId": "ct-agent-cli",
      "name": "ct-agent CLI (device code login)",
      "description": "Public client for `ct-agent login` (RFC 8628 device code grant). No client secret -- a CLI on the operator's own machine can't keep one confidential. Details in docs/channel.md. Keycloak caps this column at 255 chars.",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "true"
      },
      "defaultClientScopes": [
        "email",
        "profile"
      ],
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "id",
            "claim.name": "sub",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "praktikum-creator",
      "name": "RN Praktikum Creator",
      "description": "RN Praktikum relying-party client for praktikum.bunsenbrenner.org (Gelb tunnel, authorized via authorize-pipeline.sh, not portal self-service). Carries gitlab-groups-claim so group gating reads a real claim, not a hardcoded allowlist.",
      "secret": "${KC_PRAKTIKUM_CREATOR_CLIENT_SECRET:}",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "https://praktikum.bunsenbrenner.org/oauth2/callback",
        "https://rn-praktikum.bunsenbrenner.org/oauth2/callback",
        "https://riisc.bunsenbrenner.org/oauth2/callback"
      ],
      "webOrigins": [
        "https://praktikum.bunsenbrenner.org",
        "https://rn-praktikum.bunsenbrenner.org",
        "https://riisc.bunsenbrenner.org"
      ],
      "defaultClientScopes": [
        "email",
        "profile"
      ],
      "protocolMappers": [
        {
          "name": "gitlab-groups-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "gitlab_groups",
            "claim.name": "gitlab_groups",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "audience-praktikum-creator",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "praktikum-creator",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "sort-bridge-automation",
      "name": "sort bridge auto-approval (service account, #501/sort#9)",
      "secret": "${KC_SORT_BRIDGE_AUTOMATION_CLIENT_SECRET:}",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "fullScopeAllowed": true
    },
    {
      "clientId": "devsystem-remote-cli",
      "name": "CADS-devsystem devsystem_iterate --remote",
      "description": "Real M2M service account for headless devsystem_iterate --remote calls against devsystem-demo.bunsenbrenner.org (CADS-devsystem issue #7 / CADS-Tunnel#382-follow).",
      "secret": "${KC_DEVSYSTEM_REMOTE_CLI_CLIENT_SECRET:}",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "fullScopeAllowed": true
    },
    {
      "clientId": "labor-setup-android-emulator-test",
      "name": "labor-setup.com Android emulator/walkthrough service",
      "description": "M2M service account for labor-setup.com real Android emulator walkthrough service report-back (CADS-devsystem issue, docs/android-emulator-walkthrough-service-requirements.md).",
      "secret": "${KC_LABOR_SETUP_ANDROID_EMULATOR_TEST_CLIENT_SECRET:}",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "fullScopeAllowed": true
    },
    {
      "clientId": "labor-setup-document-extraction",
      "name": "labor-setup.com document-extraction agent",
      "description": "M2M service account for labor-setup.com real devsystem.document_extraction agent report-back (CADS-devsystem issue, docs/document-extraction-agent-requirements.md).",
      "secret": "${KC_LABOR_SETUP_DOCUMENT_EXTRACTION_CLIENT_SECRET:}",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "fullScopeAllowed": true
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "providerId": "google",
      "enabled": true,
      "trustEmail": false,
      "storeToken": false,
      "linkOnly": false,
      "config": {
        "clientId": "${KC_GOOGLE_CLIENT_ID:}",
        "clientSecret": "${KC_GOOGLE_CLIENT_SECRET:}",
        "syncMode": "FORCE"
      }
    },
    {
      "alias": "github",
      "providerId": "github",
      "enabled": true,
      "trustEmail": false,
      "storeToken": false,
      "linkOnly": false,
      "config": {
        "clientId": "${KC_GITHUB_CLIENT_ID:}",
        "clientSecret": "${KC_GITHUB_CLIENT_SECRET:}",
        "syncMode": "FORCE"
      }
    },
    {
      "alias": "gitlab",
      "providerId": "gitlab",
      "enabled": true,
      "trustEmail": false,
      "storeToken": false,
      "linkOnly": false,
      "config": {
        "clientId": "${KC_GITLAB_CLIENT_ID:}",
        "clientSecret": "${KC_GITLAB_CLIENT_SECRET:}",
        "syncMode": "FORCE"
      }
    },
    {
      "alias": "haw-gitlab",
      "displayName": "HAW GitLab (git.haw-hamburg.de)",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": true,
      "storeToken": true,
      "addReadTokenRoleOnCreate": true,
      "linkOnly": false,
      "config": {
        "clientId": "${KC_HAW_GITLAB_CLIENT_ID:}",
        "clientSecret": "${KC_HAW_GITLAB_CLIENT_SECRET:}",
        "issuer": "https://git.haw-hamburg.de",
        "authorizationUrl": "https://git.haw-hamburg.de/oauth/authorize",
        "tokenUrl": "https://git.haw-hamburg.de/oauth/token",
        "userInfoUrl": "https://git.haw-hamburg.de/oauth/userinfo",
        "jwksUrl": "https://git.haw-hamburg.de/oauth/discovery/keys",
        "useJwksUrl": "true",
        "defaultScope": "openid profile email read_api read_repository",
        "hideOnLoginPage": "true",
        "syncMode": "FORCE"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "email-importer",
      "identityProviderAlias": "google",
      "identityProviderMapper": "google-user-attribute-mapper",
      "config": {
        "claim": "email",
        "user.attribute": "email",
        "syncMode": "FORCE"
      }
    },
    {
      "name": "email-importer",
      "identityProviderAlias": "github",
      "identityProviderMapper": "github-user-attribute-mapper",
      "config": {
        "claim": "email",
        "user.attribute": "email",
        "syncMode": "FORCE"
      }
    },
    {
      "name": "email-importer",
      "identityProviderAlias": "gitlab",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "claim": "email",
        "user.attribute": "email",
        "syncMode": "FORCE"
      }
    },
    {
      "name": "gitlab-groups",
      "identityProviderAlias": "haw-gitlab",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "claim": "groups",
        "user.attribute": "gitlab_groups",
        "syncMode": "FORCE"
      }
    }
  ],
  "loginTheme": "ct-bunsenbrenner",
  "accountTheme": "ct-bunsenbrenner",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "en",
    "de"
  ],
  "defaultLocale": "en"
}
